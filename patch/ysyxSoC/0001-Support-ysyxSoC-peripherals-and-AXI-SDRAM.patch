+
+  wire        apb_access = in_psel & in_penable;
+  wire        apb_write  = apb_access & in_pwrite;
+  wire [18:0] fb_waddr   = in_paddr[20:2];
+  wire        fb_wen     = apb_write & (fb_waddr < FB_SIZE);
+
