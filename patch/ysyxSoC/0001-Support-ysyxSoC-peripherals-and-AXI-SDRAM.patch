+    if (fb_wen) begin
+      if (in_pstrb[0]) fb[fb_waddr][7:0]   <= in_pwdata[7:0];
+      if (in_pstrb[1]) fb[fb_waddr][15:8]  <= in_pwdata[15:8];
+      if (in_pstrb[2]) fb[fb_waddr][23:16] <= in_pwdata[23:16];
+      if (in_pstrb[3]) fb[fb_waddr][31:24] <= in_pwdata[31:24];
