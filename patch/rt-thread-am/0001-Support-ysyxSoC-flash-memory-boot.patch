diff --git a/bsp/abstract-machine/src/context.c b/bsp/abstract-machine/src/context.c
index ee38829ae..a8a40bfb4 100644
--- a/bsp/abstract-machine/src/context.c
+++ b/bsp/abstract-machine/src/context.c
@@ -2,8 +2,52 @@
 #include <klib.h>
 #include <rtthread.h>
 
+struct switch_args {
+    Context **from;
+    Context **to;
+};
+static struct switch_args boot_args;
+
+struct rt_thread_wrapper_arg{
+  void (*tentry)(void * );
+  void *parameter;
+  void (*texit)(void );
+};
+
+static void rt_thread_wrapper(void *arg){
+  struct rt_thread_wrapper_arg *wrapper_arg = (struct rt_thread_wrapper_arg *)arg;
+  void (*tentry)(void * ) = wrapper_arg->tentry;
+  void *parameter = wrapper_arg->parameter;
+  void (*texit)(void ) = wrapper_arg->texit;
+  tentry(parameter);
+  texit();
+  assert(0);
+}
+
 static Context* ev_handler(Event e, Context *c) {
   switch (e.event) {
+    case EVENT_YIELD:{
+   rt_thread_t thread = rt_thread_self();
+      struct switch_args *args;
+
+      // 修复 3：防段错误！如果当前没有线程（开机阶段），去读 boot_args
+      if (thread == NULL) {
+        args = &boot_args;
+      } else {
+        args = (struct switch_args *)(thread->user_data);
+      }
+
+      // 执行上下文的保存与切换
+      if (args->from != NULL) {
+        *(args->from) = c; // 保存当前现场
+      }
+      Context *next_c = *(args->to); // 提取目标现场
+      return next_c;
+    }
+    case EVENT_IRQ_TIMER:
+      // 暂时不处理时钟中断，直接返回当前上下文，让当前线程继续跑
+      return c;
+    
     default: printf("Unhandled event ID = %d\n", e.event); assert(0);
   }
   return c;
@@ -14,11 +58,43 @@ void __am_cte_init() {
 }
 
 void rt_hw_context_switch_to(rt_ubase_t to) {
-  assert(0);
+rt_thread_t thread = rt_thread_self();
+  
+  if (thread == NULL) {
+    // 刚开机，没有当前线程！借用一下特例信箱
+    boot_args.from = NULL;
+    boot_args.to = (Context **)to;
+    yield(); 
+  } else {
+    // 理论上 switch_to 不应该在有线程运行时被调用，但为了严谨
+    struct switch_args args;
+    args.from = NULL; 
+    args.to = (Context **)to;
+    thread->user_data = (rt_ubase_t)&args;
+    yield();
+  }
 }
 
 void rt_hw_context_switch(rt_ubase_t from, rt_ubase_t to) {
-  assert(0);
+rt_thread_t thread = rt_thread_self();
+  
+  // 1. 备份原有的 user_data（保护现场！）
+  rt_ubase_t old_user_data = thread->user_data;
+
+  // 2. 在当前线程的私有栈上，临时打包参数
+  struct switch_args args;
+  args.from = (Context **)from;
+  args.to = (Context **)to;
+
+  // 3. 将栈上参数的地址塞进 PCB
+  thread->user_data = (rt_ubase_t)&args;
+
+  // 4. 引爆自陷，穿越叹息之墙！
+  yield();
+
+  // 5. 时空旅行结束。当前线程再次被调度时，代码会从这里继续执行。
+  // 此时，立刻归还 user_data，做到真正的“来无影去无踪”！
+  thread->user_data = old_user_data;
 }
 
 void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t to, struct rt_thread *to_thread) {
@@ -26,6 +102,17 @@ void rt_hw_context_switch_interrupt(void *context, rt_ubase_t from, rt_ubase_t t
 }
 
 rt_uint8_t *rt_hw_stack_init(void *tentry, void *parameter, rt_uint8_t *stack_addr, void *texit) {
-  assert(0);
-  return NULL;
+  uintptr_t stack_top = (uintptr_t)stack_addr;
+  stack_top &= ~7;
+  stack_top -= sizeof(struct rt_thread_wrapper_arg);
+  struct rt_thread_wrapper_arg *args = (struct rt_thread_wrapper_arg *)stack_top;
+  args->tentry = tentry;
+  args->parameter = parameter;
+  args->texit = texit;
+  Area kstack;
+  kstack.start = (void *)0;
+  kstack.end = (void *)stack_top;
+  Context *c = kcontext(kstack, rt_thread_wrapper, args);
+  return (rt_uint8_t *)c;
+
 }
