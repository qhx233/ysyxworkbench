From 3957c290f3866c03ca628b85fc1cbe508a4a6890 Mon Sep 17 00:00:00 2001
From: ysyx_26060181 <ysyx_26060181@example.com>
Date: Sat, 4 Jul 2026 21:54:58 +0800
Subject: [PATCH] Support ysyxSoC flash memory boot

---
 bsp/abstract-machine/Makefile       |  6 ++
 bsp/abstract-machine/extra-psram.ld | 43 +++++++++++++
 bsp/abstract-machine/extra-sdram.ld | 43 +++++++++++++
 bsp/abstract-machine/src/context.c  | 95 +++++++++++++++++++++++++++--
 bsp/abstract-machine/src/uart.c     |  8 ++-
 5 files changed, 190 insertions(+), 5 deletions(-)
 create mode 100644 bsp/abstract-machine/extra-psram.ld
 create mode 100644 bsp/abstract-machine/extra-sdram.ld

diff --git a/bsp/abstract-machine/Makefile b/bsp/abstract-machine/Makefile
index 8d70f310b..0a504c7aa 100644
--- a/bsp/abstract-machine/Makefile
+++ b/bsp/abstract-machine/Makefile
@@ -8,7 +8,13 @@ NAME = rtthread
 SRCS = $(shell find src -name "*.c")
 CFLAGS += -DHAVE_CCONFIG_H -D__RTTHREAD__
 CFLAGS += -Wno-nonnull-compare
+ifeq ($(ARCH),riscv32e-ysyxsoc-flash-psram)
+LDFLAGS += -T extra-psram.ld
+else ifeq ($(ARCH),riscv32e-ysyxsoc-flash-sdram)
+LDFLAGS += -T extra-sdram.ld
+else
 LDFLAGS += -T extra.ld
+endif
 -include $(FILE_MK)
 -include $(AM_APPS_MK)
 include $(AM_HOME)/Makefile
diff --git a/bsp/abstract-machine/extra-psram.ld b/bsp/abstract-machine/extra-psram.ld
new file mode 100644
index 000000000..c2006a798
--- /dev/null
+++ b/bsp/abstract-machine/extra-psram.ld
@@ -0,0 +1,43 @@
+SECTIONS {
+  .data.extra : {
+    . = ALIGN(8);
+    __fsymtab_start = .;
+    KEEP(*(FSymTab))
+    __fsymtab_end = .;
+    . = ALIGN(8);
+    __vsymtab_start = .;
+    KEEP(*(VSymTab))
+    __vsymtab_end = .;
+    . = ALIGN(8);
+
+    __rt_init_start = .;
+    KEEP(*(SORT(.rti_fn*)))
+    __rt_init_end = .;
+    . = ALIGN(8);
+
+    __rt_utest_tc_tab_start = .;
+    KEEP(*(UtestTcTab))
+    __rt_utest_tc_tab_end = .;
+
+    . = ALIGN(8);
+    __am_apps_data_start = .;
+    *(__am_apps.data*)
+    *(__am_apps.sdata*)
+    __am_apps_data_end = .;
+    . = ALIGN(8);
+  } > psram AT> flash
+}
+INSERT BEFORE .data;
+
+SECTIONS {
+  .bss.extra (NOLOAD) : {
+    . = ALIGN(8);
+    __am_apps_bss_start = .;
+    *(__am_apps.bss*)
+    *(__am_apps.sbss*)
+    *(__am_apps.scommon*)
+    __am_apps_bss_end = .;
+    . = ALIGN(8);
+  } > psram
+}
+INSERT BEFORE .bss;
